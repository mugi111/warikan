[Unit]
Description=Warikan Discord bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=warikan
Group=warikan
WorkingDirectory=/opt/warikan-deploy/current
EnvironmentFile=/etc/warikan/warikan.env
Environment=DATABASE_PATH=/var/lib/warikan/warikan.sqlite
ExecStart=/usr/bin/node /opt/warikan/dist/index.js
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
StateDirectory=warikan
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/warikan

[Install]
WantedBy=multi-user.target
