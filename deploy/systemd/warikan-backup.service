[Unit]
Description=Create a Warikan SQLite backup

[Service]
Type=oneshot
User=warikan
Group=warikan
WorkingDirectory=/opt/warikan-deploy/current
EnvironmentFile=/etc/warikan/warikan.env
Environment=DATABASE_PATH=/var/lib/warikan/warikan.sqlite
Environment=BACKUP_DIRECTORY=/var/lib/warikan/backups
ExecStart=/usr/bin/node /opt/warikan/dist/operations/backup-command.js
TimeoutStartSec=300
TimeoutStopSec=15
UMask=0077
StateDirectory=warikan
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/warikan

[Install]
WantedBy=multi-user.target
